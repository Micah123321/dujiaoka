{
    "name": "dujiaoka/laravel6-legacy-replay",
    "type": "project",
    "description": "Independent PHP 7.4 / Laravel 6 historical replay dependencies.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "dcat/easy-excel": "^1.0",
        "dcat/laravel-admin": "2.*",
        "fideloper/proxy": "^4.4",
        "guzzlehttp/guzzle": "^7.0.1",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^6.20.26",
        "laravel/tinker": "^2.5",
        "mews/captcha": "^3.2",
        "simplesoftwareio/simple-qrcode": "2.0.0",
        "stripe/stripe-php": "^22.0",
        "yansongda/pay": "^2.10"
    },
    "require-dev": {
        "facade/ignition": "^1.16.15",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^8.5.8|^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": true,
        "platform": {
            "php": "7.4.33"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "../../../app/"
        },
        "classmap": [
            "../../../database/seeds",
            "../../../database/factories"
        ],
        "files": [
            "../../../app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "../../"
        },
        "exclude-from-classmap": [
            "../../Integration/MySqlConcurrency/",
            "../../Compatibility/Laravel12/vendor/",
            "../../.runtime/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
